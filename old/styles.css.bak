/* =========================================================================
   FILE 01 / CHICAGO POLICE / styles.css
   Editorial-brutalist FOIA dossier. Ivory paper, heavy ink, redaction motif.
   ========================================================================= */

:root {
  --paper: #FFFFFF;
  --paper-shadow: #F4F4F4;
  --ink: #161616;
  --ink-secondary: #444444;
  --ink-tertiary: #7A7A7A;
  --rule: rgba(22, 22, 22, 0.15);
  --rule-strong: rgba(22, 22, 22, 0.4);
  --redact: #161616;
  --blood: #7A1F1F;
  --crew-burge: #161616;
  --crew-guevara: #7A1F1F;
  --crew-other: #B8B8B8;

  --serif-display: Georgia, "Times New Roman", serif;
  --serif-body: Georgia, "Times New Roman", serif;
  --mono: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

  --measure: 38rem;
  --gutter: clamp(1.25rem, 4vw, 3rem);
  --section-pad: clamp(5rem, 11vh, 9rem);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--serif-body);
  font-size: 18px;
  line-height: 1.55;
  font-feature-settings: "kern", "liga", "onum";
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: var(--ink); text-underline-offset: 3px; text-decoration-thickness: 1px; }
a:hover { text-decoration-thickness: 2px; }

::selection { background: var(--ink); color: var(--paper); }

/* -- Paper grain overlay (disabled for clean white background) ----------- */
.grain { display: none; }

/* -- File label (fixed top-left) ------------------------------------------ */
.file-label {
  position: fixed;
  top: 1.1rem;
  left: var(--gutter);
  right: var(--gutter);
  z-index: 10;
  font-family: var(--mono);
  font-size: 11.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-secondary);
  display: flex;
  gap: 0.65rem;
  align-items: baseline;
  pointer-events: none;
}
.file-label__sep { color: var(--ink-tertiary); }
.file-label__section {
  color: var(--ink);
  margin-left: auto;
  padding-left: 1rem;
  border-left: 1px solid var(--rule-strong);
  transition: color 0.3s ease;
}

/* -- Main typography ------------------------------------------------------- */
.story__title {
  font-family: var(--serif-display);
  font-weight: 600;
  font-size: clamp(2rem, 5.2vw, 3.6rem);
  line-height: 1.02;
  letter-spacing: -0.018em;
  margin: 0 0 1.6rem;
  font-variation-settings: "opsz" 80;
}

.lede {
  font-size: clamp(1.1rem, 1.6vw, 1.3rem);
  line-height: 1.5;
  color: var(--ink);
  font-style: normal;
  border-left: 2px solid var(--ink);
  padding-left: 1.25rem;
  margin: 0 0 1.8rem;
}

.prose {
  max-width: var(--measure);
  margin: 0 auto 3rem;
  padding: 0 var(--gutter);
  width: 100%;
}
.prose--narrow { max-width: 34rem; }
.prose p { margin: 0 0 1.2rem; }
.prose strong { font-weight: 600; }
.prose em { font-style: italic; }

.pull {
  font-family: var(--serif-display);
  font-weight: 400;
  font-style: italic;
  font-size: clamp(1.4rem, 3vw, 2.1rem);
  line-height: 1.2;
  margin: 2.5rem 0;
  color: var(--ink);
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
  padding: 1.4rem 0;
  text-align: left;
}
.pull--blood { color: var(--blood); border-color: var(--blood); }

.ink-tag {
  font-family: var(--mono);
  font-size: 0.78em;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.05em 0.45em;
  background: var(--ink);
  color: var(--paper);
  border-radius: 1px;
  white-space: nowrap;
}
.ink-tag--guevara { background: var(--blood); }

/* -- Simple-code download button ------------------------------------------ */
.simple-code-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
  padding: 0.3rem 0.7rem 0.32rem;
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink);
  background: transparent;
  border: 1px solid var(--ink);
  border-radius: 1px;
  text-decoration: none;
  vertical-align: 2px;
  transition: background 0.15s ease, color 0.15s ease;
}
.simple-code-btn:hover,
.simple-code-btn:focus-visible {
  background: var(--ink);
  color: var(--paper);
  outline: none;
}
.simple-code-btn__tag {
  font-weight: 600;
  font-size: 0.85rem;
  line-height: 1;
}

/* -- Chapter mark --------------------------------------------------------- */
.chapter {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 1.25rem;
  max-width: 70rem;
  margin: 0 auto 2.5rem;
  padding: 0 var(--gutter);
}
.chapter__number {
  font-family: var(--serif-display);
  font-weight: 800;
  font-size: clamp(4rem, 10vw, 6rem);
  line-height: 0.85;
  letter-spacing: -0.04em;
  color: var(--ink);
  font-variation-settings: "opsz" 144;
}
.chapter__rule { height: 1px; background: var(--ink); align-self: end; margin-bottom: 1.2rem; }
.chapter__kicker {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-secondary);
  align-self: end;
  margin-bottom: 1.2rem;
}

/* -- Sections -------------------------------------------------------------- */
.story {
  padding-top: var(--section-pad);
  padding-bottom: var(--section-pad);
  border-top: 1px solid var(--rule);
  position: relative;
}
.story--centerpiece { background: linear-gradient(to bottom, var(--paper) 0%, var(--paper-shadow) 60%, var(--paper) 100%); }
.story--sources { border-top: 2px solid var(--ink); }

/* -- Cover ---------------------------------------------------------------- */
.cover {
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto auto;
  padding: 6rem var(--gutter) 3rem;
  position: relative;
  border-bottom: 1px solid var(--rule);
}
.cover__stamp {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  display: flex;
  gap: 1.5rem;
  align-self: start;
  justify-self: end;
  border: 1.5px solid var(--ink);
  padding: 0.6rem 1rem;
  color: var(--ink);
  transform: rotate(-1.5deg);
}
.cover__title {
  font-family: var(--serif-display);
  font-weight: 800;
  font-size: clamp(2rem, 5.5vw, 4.5rem);
  line-height: 0.95;
  letter-spacing: -0.025em;
  margin: 2rem 0;
  font-variation-settings: "opsz" 144;
  color: var(--ink);
  align-self: center;
}
.cover__line { display: block; }
.cover__line--1 { font-weight: 400; font-style: italic; font-size: 0.42em; letter-spacing: 0.02em; color: var(--ink-secondary); margin-bottom: 0.4em; }
.cover__line--3 { padding-left: 1.2em; }
.cover__line--4 em { font-weight: 400; font-style: italic; color: var(--blood); }
.cover__line--5 { font-size: 0.42em; font-weight: 400; font-style: italic; color: var(--ink-secondary); letter-spacing: 0.02em; margin-top: 0.4em; padding-left: 1.2em; }
.cover__line--6 { font-size: 0.42em; font-weight: 400; font-style: italic; color: var(--ink-secondary); letter-spacing: 0.02em; padding-left: 1.2em; }
.cover__deck {
  max-width: 32rem;
  font-size: 1.1rem;
  line-height: 1.55;
  color: var(--ink-secondary);
  margin: 0;
}
.cover__meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: 0.8rem 2rem;
  margin-top: 2.5rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--ink);
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.cover__meta > div { display: flex; flex-direction: column; gap: 0.25rem; }
.cover__meta-label { color: var(--ink-tertiary); font-size: 10px; }

/* -- Charts (shared) ------------------------------------------------------ */
.chart {
  margin: 2.5rem auto 2rem;
  padding: 0 var(--gutter);
  max-width: 78rem;
}
.chart--ledger { max-width: 92rem; }
.chart--inversion { max-width: 84rem; }
.chart--categories { max-width: 70rem; }
.chart--censored { max-width: 70rem; }

.chart__canvas { width: 100%; }
.chart__canvas svg { display: block; width: 100%; height: auto; overflow: visible; }

.chart__cap {
  margin-top: 1rem;
  font-family: var(--mono);
  font-size: 11.5px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--ink-secondary);
  display: flex;
  gap: 0.9rem;
  align-items: baseline;
  border-top: 1px solid var(--rule);
  padding-top: 0.75rem;
}
.chart__cap-num {
  font-weight: 600;
  color: var(--ink);
  border-right: 1px solid var(--rule-strong);
  padding-right: 0.9rem;
  flex-shrink: 0;
}

/* -- D3 chart text styling ------------------------------------------------ */
.chart text {
  font-family: var(--mono);
  font-size: 11px;
  fill: var(--ink-secondary);
  letter-spacing: 0.04em;
}
.chart .axis-tick { fill: var(--ink-tertiary); font-size: 10.5px; text-transform: uppercase; }
.chart .annotation { fill: var(--ink); font-size: 11.5px; }
.chart .annotation--name { font-family: var(--serif-display); font-size: 14px; font-style: italic; font-weight: 600; }
.chart .annotation--blood { fill: var(--blood); }
.chart .axis path, .chart .axis line { stroke: var(--rule); shape-rendering: crispEdges; }
.chart .axis-base { stroke: var(--ink); stroke-width: 1; }

/* -- §01 LEDGER specific -------------------------------------------------- */
.chart--ledger .dot { transition: r 0.15s ease; }
.chart--ledger .leader { stroke: var(--ink); stroke-width: 0.6; fill: none; }
.chart--ledger .leader--blood { stroke: var(--blood); }

/* -- §02 CENSORED specific ------------------------------------------------ */
.chart--censored .redact-bar {
  cursor: pointer;
  transition: opacity 0.4s ease;
}
.chart--censored .redact-bar.is-revealed { opacity: 0.18; }
.chart--censored .redact-label {
  font-family: var(--mono);
  font-size: 12px;
  fill: var(--paper);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  pointer-events: none;
}
.chart--censored .redact-label tspan { display: block; }
.chart--censored .bar { fill: var(--ink); }
.chart--censored .bar-pre { fill: var(--ink-tertiary); }
.chart--censored .reveal-hint {
  font-family: var(--mono);
  font-size: 10.5px;
  fill: var(--ink-secondary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* -- §03 INVERSION specific ----------------------------------------------- */
.chart--inversion .band-rule { stroke: var(--rule); stroke-width: 0.5; stroke-dasharray: 2 3; }
.chart--inversion .ramp-line { fill: none; stroke: var(--ink); stroke-width: 1.5; }
.chart--inversion .ramp-dot { fill: var(--ink); }
.chart--inversion .ramp-dot--blood { fill: var(--blood); }
.chart--inversion .stack-segment { stroke: var(--paper); stroke-width: 1; }
.chart--inversion .stack-label { fill: var(--paper); font-weight: 600; font-size: 11px; }
.chart--inversion .stack-label--outside { fill: var(--ink); }
.chart--inversion .ramp-callout-num {
  font-family: var(--serif-display);
  font-size: 28px;
  font-weight: 600;
  fill: var(--ink);
  font-variation-settings: "opsz" 144;
}
.chart--inversion .ramp-callout-num--blood { fill: var(--blood); }

/* -- §04 CATEGORIES specific ---------------------------------------------- */
.chart--categories .cat-bar-burge { fill: var(--ink); }
.chart--categories .cat-bar-guevara { fill: var(--blood); }
.chart--categories .cat-label {
  font-family: var(--serif-body);
  font-size: 13px;
  fill: var(--ink);
  letter-spacing: 0;
  text-transform: none;
}
.chart--categories .cat-count {
  font-family: var(--mono);
  font-size: 11px;
  fill: var(--ink-secondary);
}
.chart--categories .connector {
  fill: none;
  stroke: var(--ink);
  stroke-width: 0.6;
  stroke-opacity: 0.55;
}
.chart--categories .crew-header {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 600;
}

/* -- §05 LOOKUP ----------------------------------------------------------- */
.lookup {
  max-width: 70rem;
  margin: 0 auto;
  padding: 0 var(--gutter);
}
.lookup__search {
  display: flex;
  align-items: stretch;
  border: 1.5px solid var(--ink);
  background: var(--paper);
  margin-bottom: 0.5rem;
}
.lookup__label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0.85rem 1rem;
  background: var(--ink);
  color: var(--paper);
  display: flex;
  align-items: center;
}
.lookup__search input {
  flex: 1;
  border: 0;
  background: transparent;
  font-family: var(--serif-body);
  font-size: 1.05rem;
  padding: 0.65rem 1rem;
  color: var(--ink);
  outline: none;
}
.lookup__search input::placeholder { color: var(--ink-tertiary); font-style: italic; }
.lookup__count {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-secondary);
  margin-bottom: 1rem;
  text-align: right;
}
.lookup__table-wrap {
  max-height: 70vh;
  overflow: auto;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.lookup table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--serif-body);
  font-size: 15px;
}
.lookup th {
  position: sticky;
  top: 0;
  background: var(--paper);
  z-index: 1;
  text-align: left;
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--ink);
  padding: 0.8rem 0.75rem 0.6rem;
  border-bottom: 1.5px solid var(--ink);
}
.lookup td {
  padding: 0.55rem 0.75rem;
  border-bottom: 1px solid var(--rule);
  vertical-align: baseline;
}
.lookup tr.is-crew { background: rgba(21, 19, 15, 0.04); }
.lookup .num { font-family: var(--mono); font-size: 13.5px; font-variant-numeric: tabular-nums; }
.lookup .num--blood { color: var(--blood); }
.lookup .rank { color: var(--ink-tertiary); width: 4rem; }
.lookup .rank a { text-decoration: none; color: inherit; }
.lookup .rank a:hover { color: var(--ink); text-decoration: underline; }
.lookup .name { font-weight: 600; }
.lookup .crew-badge {
  display: inline-block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.1em 0.45em;
  margin-left: 0.5em;
  vertical-align: 1px;
  border-radius: 1px;
  color: var(--paper);
}
.lookup .crew-badge--burge { background: var(--ink); }
.lookup .crew-badge--guevara { background: var(--blood); }
.lookup .empty {
  padding: 2rem 1rem;
  text-align: center;
  font-style: italic;
  color: var(--ink-secondary);
}

/* -- §04 COMPLIANCE ------------------------------------------------------- */
.chart--compliance { max-width: 72rem; }
.chart--compliance .compliance-label {
  font-family: var(--serif-body);
  font-size: 14px;
  fill: var(--ink);
  letter-spacing: 0;
  text-transform: none;
}
.chart--compliance .compliance-sub {
  font-family: var(--mono);
  font-size: 10.5px;
  fill: var(--ink-tertiary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.chart--compliance .compliance-pct {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.04em;
}

/* -- §05 ACCOUNTABILITY MAP ----------------------------------------------- */
.chart--map { max-width: 78rem; }

.map__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem 2rem;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-secondary);
  margin-bottom: 1.4rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--rule);
}
.map__legend-item { display: inline-flex; align-items: center; gap: 0.55rem; }
.map__swatch {
  display: inline-block;
  width: 28px;
  height: 0;
  border-top: 2px solid var(--ink);
}
.map__swatch--dashed { border-top-style: dashed; }
.map__swatch--blood  { border-top-color: var(--blood); }

.map__svg { width: 100%; height: auto; display: block; }

.map__svg .map__box {
  fill: var(--paper);
  stroke: var(--ink);
  stroke-width: 1.25;
}
.map__svg .map__box--strong { stroke-width: 2; fill: var(--paper-shadow); }
.map__svg .map__box--inner { fill: rgba(21, 19, 15, 0.04); stroke-dasharray: 0; }
.map__svg .map__box--outer { fill: none; stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 3; }
.map__svg .map__box--sidecar { fill: var(--paper-shadow); stroke: var(--ink); stroke-width: 1; }

.map__svg .map__box-title {
  font-family: var(--serif-display);
  font-weight: 700;
  font-size: 14px;
  fill: var(--ink);
  text-anchor: middle;
  font-variation-settings: "opsz" 144;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.map__svg .map__box-title--lg { font-size: 22px; letter-spacing: 0.04em; }

.map__svg .map__box-sub {
  font-family: var(--mono);
  font-size: 10.5px;
  fill: var(--ink-secondary);
  text-anchor: middle;
  letter-spacing: 0.04em;
}
.map__svg .map__box-sub--em { font-style: italic; fill: var(--ink); }

.map__svg .map__container-label {
  font-family: var(--mono);
  font-size: 10px;
  fill: var(--ink);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
}

.map__svg .map__tier-tag {
  font-family: var(--mono);
  font-size: 10px;
  fill: var(--ink-tertiary);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;
}
.map__svg .map__tier-name {
  font-family: var(--serif-display);
  font-size: 14px;
  fill: var(--ink-secondary);
  font-style: italic;
}

.map__svg .map__arrow {
  fill: none;
  stroke: var(--ink);
  stroke-width: 1.2;
}
.map__svg .map__arrow--solid  { stroke: var(--ink); }
.map__svg .map__arrow--dashed { stroke: var(--ink); stroke-dasharray: 5 4; }
.map__svg .map__arrow--blood  { stroke: var(--blood); stroke-width: 1.4; }
.map__svg .map__arrow--thin   { stroke: var(--ink-tertiary); stroke-width: 0.8; stroke-dasharray: 2 3; }

.map__svg .map__arrow-label {
  font-family: var(--mono);
  font-size: 10px;
  fill: var(--ink-secondary);
  letter-spacing: 0.04em;
}
.map__svg .map__arrow-label--blood { fill: var(--blood); }

.map__svg .map__arrow-group { pointer-events: bounding-box; cursor: help; }
.map__svg .map__arrow-group .map__arrow-label {
  opacity: 0;
  transition: opacity 0.18s ease;
}
.map__svg .map__arrow-group:hover .map__arrow-label,
.map__svg .map__arrow-group:focus-within .map__arrow-label { opacity: 1; }

@media (max-width: 720px) {
  .map__legend { font-size: 10px; gap: 0.8rem 1.2rem; }
  .map__svg .map__box-title { font-size: 12px; }
  .map__svg .map__box-title--lg { font-size: 16px; }
  .map__svg .map__box-sub { font-size: 9px; }
  .map__svg .map__arrow-label { font-size: 9px; }
}

/* -- §05 TIMELINE --------------------------------------------------------- */
.chart--timeline { max-width: 64rem; }

.timeline {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1.5px solid var(--ink);
  border-bottom: 1.5px solid var(--ink);
}

.timeline__era {
  display: grid;
  grid-template-columns: 8rem 1fr auto;
  align-items: baseline;
  gap: 1.5rem;
  padding: 1.4rem 0 1.2rem;
  border-bottom: 1px solid var(--ink);
  background: var(--paper-shadow);
  padding-left: 1.25rem;
  padding-right: 1.25rem;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.timeline__era-tag {
  font-weight: 600;
  color: var(--ink);
}
.timeline__era-name {
  font-family: var(--serif-display);
  font-style: italic;
  font-weight: 400;
  font-size: 1.25rem;
  letter-spacing: -0.005em;
  text-transform: none;
  color: var(--ink);
}
.timeline__era-span {
  color: var(--ink-secondary);
  font-variant-numeric: tabular-nums;
}

.timeline__entry {
  display: grid;
  grid-template-columns: 8rem 1fr;
  gap: 1.5rem;
  padding: 1.6rem 1.25rem;
  border-bottom: 1px solid var(--rule);
}
.timeline__entry:last-child { border-bottom: 0; }

.timeline__year {
  font-family: var(--serif-display);
  font-weight: 800;
  font-size: 2.4rem;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  font-variation-settings: "opsz" 144;
  padding-top: 0.1rem;
}
.timeline__entry--blood .timeline__year { color: var(--blood); }

.timeline__body {
  padding-left: 1.5rem;
  border-left: 1px solid var(--rule-strong);
  position: relative;
}
.timeline__body::before {
  content: "";
  position: absolute;
  left: -4.5px;
  top: 0.55rem;
  width: 8px;
  height: 8px;
  background: var(--ink);
  border-radius: 50%;
}
.timeline__entry--blood .timeline__body::before { background: var(--blood); }
.timeline__title {
  font-family: var(--serif-display);
  font-weight: 600;
  font-size: 1.25rem;
  line-height: 1.2;
  letter-spacing: -0.005em;
  margin: 0 0 0.5rem;
  color: var(--ink);
}
.timeline__body p {
  margin: 0;
  font-size: 1rem;
  line-height: 1.55;
  color: var(--ink-secondary);
}
.timeline__body p strong { color: var(--ink); font-weight: 600; }

.timeline__cite {
  font-family: var(--mono);
  font-size: 0.62em;
  letter-spacing: 0.04em;
  margin-left: 0.1em;
  top: -0.6em;
  position: relative;
  vertical-align: baseline;
  line-height: 0;
}
.timeline__cite a {
  color: var(--blood);
  text-decoration: none;
  padding: 0 0.1em;
  border-bottom: 1px solid transparent;
}
.timeline__cite a + a { margin-left: 0.15em; }
.timeline__cite a:hover { border-bottom-color: var(--blood); }

@media (max-width: 720px) {
  .timeline__era { grid-template-columns: 1fr; gap: 0.3rem; padding-left: 1rem; padding-right: 1rem; }
  .timeline__era-name { font-size: 1.1rem; }
  .timeline__entry { grid-template-columns: 1fr; gap: 0.6rem; padding: 1.3rem 1rem; }
  .timeline__entry::before { display: none; }
  .timeline__body { padding-left: 0; border-left: 0; }
  .timeline__year { font-size: 1.8rem; }
}

/* -- §06 SOURCES ---------------------------------------------------------- */
.cite {
  border-left: 2px solid var(--ink);
  padding: 0.5rem 0 0.5rem 1.4rem;
  margin: 2rem 0;
  font-size: 1.02rem;
  color: var(--ink-secondary);
}
.cite a { color: var(--blood); }
.caveats {
  list-style: none;
  padding: 0;
  margin: 2.5rem 0 0;
  counter-reset: caveat;
  border-top: 1px solid var(--ink);
}
.caveats li {
  display: grid;
  grid-template-columns: 3rem 1fr;
  gap: 1rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid var(--rule);
}
.caveats__num {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-tertiary);
  padding-top: 0.15rem;
}

.colophon {
  margin-top: 4rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--ink);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-tertiary);
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  max-width: var(--measure);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--gutter);
  padding-right: var(--gutter);
}

/* =========================================================================
   ARTICLE FORMAT — hero, prose article, pull quotes, inline photos, explore
   ========================================================================= */

/* -- HERO ----------------------------------------------------------------- */
.hero {
  max-width: 70rem;
  margin: 0 auto;
  padding: clamp(2.5rem, 6vh, 5rem) var(--gutter) clamp(2rem, 5vh, 4rem);
}
.hero__photo {
  margin: 0 0 2rem;
  position: relative;
}
.hero__img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 70vh;
  object-fit: cover;
  border: 1px solid var(--ink);
}
.hero__placeholder {
  display: none;
  width: 100%;
  height: 56vh;
  background: var(--paper-shadow);
  border: 1px dashed var(--ink-tertiary);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: var(--mono);
  color: var(--ink-tertiary);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.hero__placeholder small { font-size: 10px; letter-spacing: 0.1em; opacity: 0.7; }
.hero__caption {
  margin-top: 0.75rem;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-tertiary);
  letter-spacing: 0.04em;
}
.credit { font-style: italic; }

.hero__text {
  max-width: 48rem;
  margin: 0 auto;
}
.hero__kicker {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--blood);
  margin: 0 0 1rem;
}
.hero__headline {
  font-family: var(--serif-display);
  font-weight: 700;
  font-size: clamp(2rem, 4.8vw, 3.4rem);
  line-height: 1.04;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin: 0 0 1.25rem;
  font-variation-settings: "opsz" 96;
}
.hero__dek {
  font-family: var(--serif-body);
  font-size: clamp(1.1rem, 1.6vw, 1.35rem);
  line-height: 1.45;
  color: var(--ink-secondary);
  margin: 0 0 1.5rem;
  max-width: 36rem;
}
.hero__byline {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.06em;
  color: var(--ink-secondary);
  margin: 0;
  padding-top: 1rem;
  border-top: 1px solid var(--rule);
}

/* -- ARTICLE STORY SECTIONS ----------------------------------------------- */
.story--article {
  padding-top: clamp(1.5rem, 4vh, 3rem);
  padding-bottom: clamp(1.5rem, 4vh, 3rem);
}
.story--article .prose,
.prose.article {
  max-width: 36rem;
}
.prose.article p {
  font-size: 1.05rem;
  line-height: 1.65;
  margin: 0 0 1.1rem;
}
.prose.article p.lede {
  font-family: var(--serif-display);
  font-size: clamp(1.25rem, 2vw, 1.55rem);
  line-height: 1.35;
  font-weight: 600;
  color: var(--ink);
  margin: 0 0 1.6rem;
  border-left: none;
  padding-left: 0;
  font-style: normal;
  letter-spacing: -0.005em;
}

/* -- PULL QUOTES (in article prose) --------------------------------------- */
.pull-quote {
  margin: 2rem 0;
  padding: 1.2rem 0 1.2rem 1.4rem;
  border-left: 3px solid var(--blood);
  font-family: var(--serif-display);
  font-style: italic;
  font-size: clamp(1.2rem, 2vw, 1.5rem);
  line-height: 1.35;
  color: var(--ink);
}
.pull-quote cite {
  display: block;
  margin-top: 0.85rem;
  font-family: var(--mono);
  font-style: normal;
  font-size: 11px;
  letter-spacing: 0.06em;
  color: var(--ink-tertiary);
  text-transform: uppercase;
}
.kicker-quote {
  margin: 1.5rem 0 0;
  padding: 1.5rem 0;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
  font-family: var(--serif-display);
  font-style: italic;
  font-size: clamp(1.3rem, 2.4vw, 1.8rem);
  line-height: 1.3;
  color: var(--ink);
}

/* -- INLINE ARTICLE PHOTO ------------------------------------------------- */
.article-photo {
  max-width: 48rem;
  margin: 2.5rem auto;
  padding: 0 var(--gutter);
  position: relative;
}
.article-photo__img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--ink);
}
.article-photo__placeholder {
  display: none;
  width: 100%;
  height: 40vh;
  background: var(--paper-shadow);
  border: 1px dashed var(--ink-tertiary);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: var(--mono);
  color: var(--ink-tertiary);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.article-photo__placeholder small { font-size: 10px; letter-spacing: 0.1em; opacity: 0.7; }
.article-photo__caption {
  margin-top: 0.6rem;
  font-family: var(--mono);
  font-size: 11px;
  line-height: 1.5;
  color: var(--ink-tertiary);
}
.article-photo__caption strong {
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 0.25rem;
}

/* -- EXPLORE MORE --------------------------------------------------------- */
.story--explore {
  border-top: 2px solid var(--ink);
  margin-top: clamp(3rem, 8vh, 6rem);
  padding-top: clamp(2.5rem, 6vh, 4rem);
}
.explore-block {
  max-width: 70rem;
  margin: 3rem auto;
  padding: 0 var(--gutter);
}
.explore-block__title {
  font-family: var(--serif-display);
  font-weight: 600;
  font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  line-height: 1.15;
  margin: 0 0 0.8rem;
  color: var(--ink);
  max-width: var(--measure);
}
.explore-block__sub {
  max-width: var(--measure);
  margin: 0 0 1.5rem;
  color: var(--ink-secondary);
}

/* -- Responsive ----------------------------------------------------------- */
@media (max-width: 720px) {
  body { font-size: 17px; }
  .file-label { font-size: 10px; gap: 0.4rem; }
  .file-label__section { padding-left: 0.5rem; }
  .chapter { grid-template-columns: auto 1fr; gap: 0.8rem; }
  .chapter__number { font-size: 3.5rem; }
  .chapter__kicker { grid-column: 1 / -1; align-self: start; margin-bottom: 0; margin-top: -0.4rem; padding-left: 0.2rem; }
  .chapter__rule { display: none; }
  .cover { padding-top: 5rem; }
  .cover__stamp { justify-self: start; transform: rotate(-2.5deg); }
  .cover__title { font-size: 2.2rem; }
}
